{
  "name": "hds-android",
  "version": "0.1.0-preview.9.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && npm run typecheck:runtime",
    "typecheck:runtime": "node scripts/typecheck-runtime.mjs",
    "build": "npm run typecheck && vite build",
    "build:host": "node scripts/build-mobile-host.mjs",
    "test": "npm run build:host && node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "android:sync": "npm run build && cap sync android",
    "test:ui": "npm run build:host && node scripts/test-ui.mjs"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@cordisjs/plugin-http": "0.6.3",
    "@minatojs/driver-sqlite": "4.7.0",
    "koishi": "4.18.11",
    "koishi-plugin-adapter-onebot": "6.9.5",
    "qface": "1.4.1",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "silk-wasm": "3.7.1",
    "undici": "7.30.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@types/node": "22.10.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.28.2",
    "playwright-core": "1.51.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  },
  "overrides": {
    "@cordisjs/plugin-proxy-agent": {
      "undici": "6.29.1"
    }
  }
}
